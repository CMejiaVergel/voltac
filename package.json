{
  "name": "voltac-platform",
  "version": "1.0.0",
  "private": true,
  "description": "Plataforma de Voltac Systems S.A.S. Una empresa, dos lineas de negocio, un solo nucleo.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:systems": "npm run dev --workspace=@voltac/systems",
    "dev:energy": "npm run dev --workspace=@voltac/energy",
    "build:systems": "npm run build --workspace=@voltac/systems",
    "build:energy": "npm run build --workspace=@voltac/energy",
    "build": "npm run build:systems && npm run build:energy",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "overrides": {
    "postcss": ">=8.5.10"
  },
  "optionalDependencies": {
    "lightningcss-linux-x64-gnu": "1.32.0",
    "@tailwindcss/oxide-linux-x64-gnu": "4.2.2",
    "@img/sharp-linux-x64": "0.34.5",
    "@img/sharp-libvips-linux-x64": "1.2.4"
  }
}
