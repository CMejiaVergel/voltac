# ─── Voltac Systems — npm Security Policy ───────────────────────────────────
# Refs: https://docs.npmjs.com/cli/v10/configuring-npm/npmrc

# 1. LOCKFILE: siempre usar package-lock.json exacto en CI/producción
# Usar siempre: npm ci (en lugar de npm install) en VPS

# 2. AUDIT: fallar el install si hay vulnerabilidades HIGH o CRITICAL
audit-level=high

# 3. ENGINE STRICT: respetar versiones de Node declaradas
engine-strict=false

# 4. FUND: desactivar mensajes de donación en CI
fund=false

# 5. LOGLEVEL: reducir ruido en producción
# loglevel=warn

# ─── Nota sobre install scripts ──────────────────────────────────────────────
# Los paquetes que ejecutan scripts legítimos en este proyecto:
#   - sharp@0.34.x       → compila binarios nativos para procesamiento de imagen
#   - sqlite3@6.x        → compila binarios nativos para SQLite
#   - unrs-resolver@1.x  → verificación de integridad de binarios (napi-postinstall)
# Todos verificados como legítimos. No se detectó TanStack comprometido.
