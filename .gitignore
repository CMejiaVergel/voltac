# Artefactos de compilación de TypeScript
tsconfig.tsbuildinfo

# Next.js lo regenera en cada build, incluida su version. Versionarlo hacia que
# cada 'git pull' en el servidor fallara con "local changes would be overwritten".
next-env.d.ts

# Configuración local de Claude Code (rutas y puertos propios de cada máquina).
# .claude/launch.json sí se versiona: define cómo levantar el servidor de dev.
.claude/settings.local.json

# SQLite database — each environment manages its own instance
*.db
*.db-shm
*.db-wal
